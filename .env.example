APP_ENV=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql+mysqldb://user:password@host:3306/database_name
ADMIN_ID=replace-with-a-private-admin-id
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=school@example.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Set these to durable mounted storage paths on your hosting provider.
UPLOAD_FOLDER=/data/uploads
LIBRARY_UPLOAD_FOLDER=/data/library
RESULTS_FOLDER=/data/results
